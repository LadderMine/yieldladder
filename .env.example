# Stellar network (mainnet | testnet)
STELLAR_NETWORK=testnet

# Soroban RPC endpoint
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Deployed contract addresses
VAULT_ROUTER_ADDRESS=
VAULT_FLEX_ADDRESS=
VAULT_L3_ADDRESS=
VAULT_L6_ADDRESS=
VAULT_L12_ADDRESS=
STRATEGY_VAULT_ADDRESS=
HARVESTER_ADDRESS=
GOVERNANCE_ADDRESS=

# Next.js public API base URL
NEXT_PUBLIC_API_URL=http://localhost:3000

# Wallet onboarding & USDC trustline detection (issue #143)
# Network this app targets — used to detect a connected wallet pointed at
# a different one before the user attempts to sign.
NEXT_PUBLIC_STELLAR_NETWORK=testnet
# Horizon endpoint used for trustline detection (app/src/services/horizon.ts).
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
# Classic asset code/issuer for the deposit asset. Leave
# NEXT_PUBLIC_USDC_ISSUER unset to skip the trustline check cleanly (the
# deposit flow proceeds without it) until this deployment's USDC issuer is
# known.
NEXT_PUBLIC_USDC_ASSET_CODE=USDC
NEXT_PUBLIC_USDC_ISSUER=